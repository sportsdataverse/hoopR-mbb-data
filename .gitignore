# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Editor / OS debris
.vscode
.DS_Store
**/.DS_Store

# Python bytecode caches
__pycache__/
*.pyc

# python build writes release-only CSVs locally; never commit them.
# Built rds/csv ship to the sportsdataverse-data releases, not to git.
mbb/*/csv/
mbb/*/rds/

# Run logs: logs/ stays tracked (per-season run logs are committed); ignore
# stray *.log / *.out / *_logfile.txt debris everywhere else.
*.log
!logs/*.log
/*.out
/*_logfile.txt

# Tool scratch directories (bare and nested).
.omc/
**/.omc/
.Rproj.user/
**/.Rproj.user/
.ruff_cache/
**/.ruff_cache/
.understand-anything/
**/.understand-anything/
.superpowers/
**/.superpowers/
.pytest_cache/
**/.pytest_cache/
.venv/
**/.venv/
